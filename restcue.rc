#include "resource.h"

IDI_RESTCUE ICON "assets/restcue.ico"
1 24 "restcue.manifest"

1 VERSIONINFO
FILEVERSION 2,7,0,0
PRODUCTVERSION 2,7,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "RestCue\0"
            VALUE "FileDescription", "RestCue - Eye Rest Reminder\0"
            VALUE "FileVersion", "2.7.0\0"
            VALUE "InternalName", "RestCue\0"
            VALUE "OriginalFilename", "RestCue.exe\0"
            VALUE "ProductName", "RestCue\0"
            VALUE "ProductVersion", "2.7.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
